#!/bin/sh
# {{ ansible_managed }}
# Clone or update the checkout before the galaxy installs, so requirements
# come from the revision that is about to run. A failed fetch keeps the
# existing checkout, so a git host outage does not skip the run.
set -eu
repo={{ (ansible_checkout_dir ~ '/repo') | quote }}
# Mirrors ansible-pull --accept-host-key, scoped to this script.
export GIT_SSH_COMMAND='ssh -o StrictHostKeyChecking=accept-new'

[ -d "$repo/.git" ] || git clone --no-checkout {{ ansible_repo | quote }} "$repo"

# ponytail: ansible_branch must be a branch or tag, not a commit SHA.
if git -C "$repo" fetch origin {{ ansible_branch | quote }}; then
    git -C "$repo" checkout --force --detach FETCH_HEAD
elif git -C "$repo" rev-parse --verify -q HEAD >/dev/null; then
    echo "fetch failed, running the existing checkout" >&2
else
    echo "fetch failed and no checkout exists" >&2
    exit 1
fi
