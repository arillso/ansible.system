# {{ ansible_managed }}
# Systemd-resolved configuration
{% macro yn(value) %}{{ ('yes' if value else 'no') if value is boolean else value }}{% endmacro %}
{% set _dns = network_resolved_dns or network_dns_nameservers %}
{% set _domains = network_resolved_domains or (([network_dns_domain] if network_dns_domain else []) + network_dns_search) %}

[Resolve]
{% if _dns | length > 0 %}
DNS={{ _dns | join(' ') }}
{% endif %}
{% if network_resolved_fallback_dns | length > 0 %}
FallbackDNS={{ network_resolved_fallback_dns | join(' ') }}
{% endif %}
{% if _domains | length > 0 %}
Domains={{ _domains | join(' ') }}
{% endif %}
LLMNR={{ yn(network_resolved_llmnr) }}
MulticastDNS={{ yn(network_resolved_multicast_dns) }}
DNSSEC={{ yn(network_resolved_dnssec) }}
DNSOverTLS={{ yn(network_resolved_dns_over_tls) }}
Cache={{ yn(network_resolved_cache) }}
DNSStubListener={{ yn(network_resolved_dnsstublistener) }}
