# {{ ansible_managed }}
# APT Preferences for Version Pinning
# APT applies the first specific-form record that matches a version, so the
# allow record must come before the block record of the same package.
# The optional "N:" prefix matches Debian epochs such as docker-ce's "5:";
# any non-digit may follow the version (15 matches 15+248, 1.24 matches 1.24.0-1).

{% for package, version in packages_unattended_upgrades_version_pins.items() %}
# Allow {{ package }} {{ version }}
Package: {{ package }}
Pin: version /^([0-9]+:)?{{ version | string | regex_escape }}([^0-9]|$)/
Pin-Priority: 990

# Block every other version of {{ package }}
Package: {{ package }}
Pin: version *
Pin-Priority: -1

{% endfor %}
