# I/O Scheduler udev rules
# Generated by Ansible system tuning role
#
# This file configures I/O schedulers for storage devices
# auto: NVMe devices get none, all others mq-deadline

{% if _tuning_optimized_storage_devices is defined %}
{% for device in _tuning_optimized_storage_devices %}
# {{ device.name }}: {{ device.scheduler }}
ACTION=="add|change", KERNEL=="{{ device.name }}", ATTR{queue/scheduler}="{{ device.scheduler }}"
{% endfor %}
{% endif %}
